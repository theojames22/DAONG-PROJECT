# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings → API.
#
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never put the
# service-role key in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used for Head-created accounts and controlled storage cleanup.
# Keep this out of git and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
